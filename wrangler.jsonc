{
  // Must match the Worker name in Cloudflare (the one serving clembartmedia.com).
  "name": "broken-wood-677d",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables set in the dashboard when deploying from GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
